{
  "name": "new-contemporary-photography",
  "version": "1.1.0",
  "description": "A quiet photography showcase for the New Contemporary Photography Flickr group.",
  "private": true,
  "scripts": {
    "config": "node --env-file-if-exists=.env.local generate-config.js",
    "curate": "node --env-file-if-exists=.env.local curate-photos.js",
    "pages": "node --env-file-if-exists=.env.local generate-pages.js",
    "build": "node --env-file-if-exists=.env.local generate-config.js && node --env-file-if-exists=.env.local generate-pages.js",
    "dev": "npm run config && npm run pages && node dev-server.js",
    "start": "npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mendiak/new-contemporary-photography.git"
  },
  "keywords": [
    "photography",
    "flickr",
    "gallery"
  ],
  "author": "Mikel Aramendia",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Mendiak/new-contemporary-photography/issues"
  },
  "homepage": "https://github.com/Mendiak/new-contemporary-photography#readme"
}
